{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc",
    "jsx-a11y"
  ],
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".impeccable/**",
    "dist/**"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "typescript/no-explicit-any": "error",
    "no-unused-vars": "error",
    "eqeqeq": "error"
  }
}
