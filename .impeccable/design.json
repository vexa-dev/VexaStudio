  "components": [
    {
      "name": "Acción primaria",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acción principal con tinta adaptada al tema.",
      "html": "<button class=\"ds-button ds-primary\">Crear proyecto</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;border:0;border-radius:9px;padding:12px 17px;min-height:42px;font:500 12px \"IBM Plex Sans\",sans-serif;cursor:pointer;transition:background .15s,color .15s,border-color .15s,box-shadow .15s}.ds-button:disabled{opacity:.45;cursor:not-allowed}.ds-button:focus-visible{outline:2px solid var(--accent);outline-offset:4px}.ds-primary{background:var(--accent);color:var(--accent-ink);box-shadow:0 5px 15px -8px rgba(95,222,244,.35),inset 0 1px 0 rgba(255,255,255,.4)}.ds-primary:hover{background:color-mix(in srgb,var(--accent),white 15%)}@media(prefers-reduced-motion:reduce){*{transition-duration:.01ms!important;animation:none!important}}"
    },
    {
      "name": "Acción secundaria",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Acción de apoyo en superficie sólida.",
      "html": "<button class=\"ds-button ds-secondary\">Cancelar</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;border:0;border-radius:9px;padding:12px 17px;min-height:42px;font:500 12px \"IBM Plex Sans\",sans-serif;cursor:pointer;transition:background .15s,color .15s,border-color .15s,box-shadow .15s}.ds-button:disabled{opacity:.45;cursor:not-allowed}.ds-button:focus-visible{outline:2px solid var(--accent);outline-offset:4px}.ds-secondary{background:var(--raised);color:var(--text)}.ds-secondary:hover{background:var(--hover)}@media(prefers-reduced-motion:reduce){*{transition-duration:.01ms!important;animation:none!important}}"
    },
    {
      "name": "Botón de icono",
      "kind": "button",
      "refersTo": "icon-button",
      "description": "Herramienta compacta con nombre accesible.",
      "html": "<button class=\"ds-icon\" aria-label=\"Cerrar panel\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m18 6-12 12M6 6l12 12\"/></svg></button>",
      "css": ".ds-icon{border:0;background:transparent;min-height:36px;min-width:36px;display:inline-grid;place-items:center;border-radius:8px;color:var(--muted);cursor:pointer;transition:background .15s,color .15s}.ds-icon:hover{background:var(--hover);color:var(--accent)}.ds-icon:focus-visible{outline:2px solid var(--accent);outline-offset:4px}@media(prefers-reduced-motion:reduce){*{transition-duration:.01ms!important;animation:none!important}}"
    },
    {
      "name": "Campo de texto",
      "kind": "input",
      "refersTo": "field",
      "description": "Campo sólido y etiquetado para trabajo estable.",
      "html": "<div class=\"ds-field\"><label for=\"ds-project-name\">Nombre del proyecto</label><input id=\"ds-project-name\" placeholder=\"Una nueva idea\"></div>",
      "css": ".ds-field{display:grid;gap:9px;margin-bottom:22px;font:12px \"IBM Plex Sans\",sans-serif;color:var(--text)}.ds-field label{font-weight:500}.ds-field input{width:100%;padding:12px;border:1px solid var(--line);background:var(--input);color:var(--text);border-radius:8px;font:13px \"IBM Plex Sans\",sans-serif;caret-color:var(--accent);transition:background .15s,border-color .15s}.ds-field input::placeholder{color:var(--muted);opacity:1}.ds-field input:focus-visible{outline:2px solid var(--accent);outline-offset:4px}@media(prefers-reduced-motion:reduce){*{transition-duration:.01ms!important;animation:none!important}}"
    },
    {
      "name": "Destino de navegación",
