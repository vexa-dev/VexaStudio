# Copia este archivo a `.env.local` (ignorado por git). No guardes claves reales aquí.
#
# Fuente de datos: `mock` (por defecto, datos simulados en el navegador) o `supabase`.
VITE_DATA_SOURCE=mock

# Supabase local (`npm run db:start`). La URL es la local; la clave pública sale de
# `supabase status -o env` (variable PUBLISHABLE_KEY o ANON_KEY). Usa SOLO la clave
# pública: jamás la `service_role` ni la secreta.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Solo con el mock: define cualquier valor para volver al retraso artificial de 150–300 ms
# (por defecto es casi nulo) y probar los estados de carga.
# VITE_MOCK_LATENCY=1
