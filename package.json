{
  "name": "vexastudio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @vexa/web --",
    "build": "npm run build --workspace @vexa/web",
    "preview": "npm run preview --workspace @vexa/web --",
    "typecheck": "tsc -p tsconfig.tools.json && npm run typecheck --workspaces --if-present",
    "lint": "node scripts/check-boundaries.mjs && oxlint apps/web/src packages apps/web/vite.config.ts vitest.config.ts scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run apps/web/src/services/supabase/integration.test.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
}
